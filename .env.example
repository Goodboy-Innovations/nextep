# Local development (`npm run dev`) against the Postgres from `docker compose up -d db`.
DATABASE_URL="postgres://nextep:nextep@localhost:5432/nextep"
# The site's address: links, ICS feeds and OAuth redirect URIs. Optional for `npm run dev`
# (defaults to http://localhost:5173); required by the built server.
ORIGIN="http://localhost:5173"

# ChurchTools sign-in needs no variables: churches connect their instance on /register.

# Comma-separated emails that become platform admins when they sign in with email + password
# (never through ChurchTools). For a fresh installation: npm run create-admin -- <email>
ADMIN_EMAILS=""

# Hosted feedback chat for signed-in users, proxied through /api/feedback. Off unless both are
# set; FEEDBACK_SECRET is the "nextep" project's secret on the feedback-chat server.
FEEDBACK_CHAT_URL=""
FEEDBACK_SECRET=""

# Used by `docker compose` (the container runs on port 3000).
DOCKER_PUBLIC_URL="http://localhost:3000"
