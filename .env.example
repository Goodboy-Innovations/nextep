# Local development (`npm run dev`) against the Postgres from `docker compose up -d db`.
DATABASE_URL="postgres://nextep:nextep@localhost:5432/nextep"
# The site's address: links, ICS feeds and OAuth redirect URIs. Optional for `npm run dev`
# (defaults to http://localhost:5173); required by the built server.
ORIGIN="http://localhost:5173"

# Sign-in. Register the redirect URI {ORIGIN}/login/{provider}/callback at each provider,
# e.g. http://localhost:5173/login/google/callback. Providers without credentials are hidden.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# "common" = personal Outlook accounts + work/school accounts
MICROSOFT_TENANT="common"

# Comma-separated emails that may sign in without an invite and become platform admins.
ADMIN_EMAILS=""


# Used by `docker compose` (the container runs on port 3000).
DOCKER_PUBLIC_URL="http://localhost:3000"
